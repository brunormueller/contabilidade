{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "functions": {
    "api/index.ts": { "maxDuration": 60, "includeFiles": "xsd/**" }
  },
  "crons": [{ "path": "/api/cron/processar", "schedule": "0 12 * * *" }]
}
