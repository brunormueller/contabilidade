# Copie para .env e preencha. Nunca versione o .env.

# Postgres. A integração Neon da Vercel cria as duas variáveis:
# DATABASE_URL (pooled) para o app e DATABASE_URL_UNPOOLED para migrations.
# Para rodar local sem Neon, use um banco PGlite em arquivo: DATABASE_URL=pglite:.data/dev
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
DATABASE_URL_UNPOOLED=postgres://usuario:senha@host/banco?sslmode=require

# Chave AES-256-GCM que cifra o certificado A1 e a senha dele: 32 bytes em base64.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder esta chave = ter que enviar o certificado de novo.
CERT_ENC_KEY=
CERT_ENC_KEY_VERSION=1

# producao_restrita (homologação, notas sem valor fiscal) ou producao
NFSE_AMBIENTE=producao_restrita

# Segredo que a Vercel Cron envia no header Authorization (Bearer)
CRON_SECRET=
